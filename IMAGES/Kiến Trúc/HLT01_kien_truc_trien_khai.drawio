rial;fontSize=13;fontColor=#333333;spacing=0;spacingLeft=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="408" y="338" width="194" height="19" as="geometry"/></mxCell><mxCell id="c20" value="dùng thực thể và quy tắc nghiệp vụ" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontColor=#333333;spacing=0;spacingLeft=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="408" y="488" width="259" height="19" as="geometry"/></mxCell><mxCell id="c21" value="Đăng nhập" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontColor=#333333;spacing=0;spacingLeft=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="770" y="93" width="77" height="19" as="geometry"/></mxCell><mxCell id="c22" value="(PKCE)" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontColor=#333333;spacing=0;spacingLeft=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="790" y="126" width="55" height="19" as="geometry"/></mxCell><mxCell id="c23" value="kiểm tra chữ ký token (JWKS)" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontColor=#333333;spacing=0;spacingLeft=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="780" y="254" width="215" height="19" as="geometry"/></mxCell><mxCell id="c24" value="cài đặt" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontColor=#333333;spacing=0;spacingLeft=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="772" y="398" width="62" height="19" as="geometry"/></mxCell><mxCell id="c25" value="giao diện" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontColor=#333333;spacing=0;spacingLeft=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="772" y="428" width="77" height="19" as="geometry"/></mxCell><mxCell id="c26" value="ánh xạ" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontColor=#333333;spacing=0;spacingLeft=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="772" y="548" width="55" height="19" as="geometry"/></mxCell><mxCell id="c27" value="thực thể" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontColor=#333333;spacing=0;spacingLeft=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="772" y="578" width="70" height="19" as="geometry"/></mxCell><mxCell id="c28" value="truy vấn SQL" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=13;fontColor=#333333;spacing=0;spacingLeft=0;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1043" y="634" width="99" height="19" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="hinh52" name="Hinh 5.2 - Trien khai Docker Compose"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="620" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Mô hình triển khai bằng Docker Compose" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=20;fontColor=#333333;spacing=0;spacingLeft=0;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="381.5" y="7" width="437" height="26" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;absoluteArcSize=1;arcSize=28;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;dashed=1;dashPattern=8 5;" vertex="1" parent="1"><mxGeometry x="290" y="60" width="880" height="530" as="geometry"/></mxCell><mxCell id="c4" value="Máy chủ Docker (docker compose up -d --build)" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=16;fontColor=#333333;spacing=0;spacingLeft=0;align=left;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="310" y="73" width="415" height="22" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b style="font-size:17px"&gt;Trình duyệt&lt;/b&gt;&lt;br&gt;Bệnh nhân, nhân viên,&lt;br&gt;bác sĩ, quản trị viên' style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fontColor=#000000;fontFamily=Arial;fontSize=14;fillColor=#F5F5F5;strokeColor=#666666;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="200" height="120" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b style="font-size:16px"&gt;web – nginx (bản build React)&lt;/b&gt;&lt;br&gt;Cổng 3000 → 80&lt;br&gt;Phục vụ file tĩnh, điều hướng SPA' style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fontColor=#000000;fontFamily=Arial;fontSize=14;fillColor=#E6E6E6;strokeColor=#898989;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="110" width="360" height="120" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b style="font-size:16px"&gt;keycloak – Keycloak 26.8.1&lt;/b&gt;&lt;br&gt;Cổng 8080 → 8080&lt;br&gt;Nhập realm hlt01 + giao diện hlt' style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fontColor=#000000;fontFamily=Arial;fontSize=14;fillColor=#DBDBDB;strokeColor=#838383;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="770" y="110" width="360" height="120" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b style="font-size:16px"&gt;api – ASP.NET Core (.NET 10)&lt;/b&gt;&lt;br&gt;Cổng 5080 → 8080&lt;br&gt;Tự chạy migration và dữ liệu mẫu' style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fontColor=#000000;fontFamily=Arial;fontSize=14;fillColor=#F2F2F2;strokeColor=#B5B5B5;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="330" y="290" width="360" height="120" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b style="font-size:16px"&gt;sqlserver – SQL Server 2022&lt;/b&gt;&lt;br&gt;Cổng 1433 → 1433&lt;br&gt;Cơ sở dữ liệu HLT01' styl