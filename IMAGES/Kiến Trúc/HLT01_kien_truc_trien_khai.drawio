<mxfile host="app.diagrams.net" agent="HLT01" version="24.7.17"><diagram id="hinh51" name="Hinh 5.1 - Kien truc phan lop"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Kiến trúc phân lớp của hệ thống HLT01" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=20;fontColor=#333333;spacing=0;spacingLeft=0;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="387.0" y="11" width="426" height="26" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b style="font-size:17px"&gt;Lớp giao diện – Ứng dụng React (web/)&lt;/b&gt;&lt;br&gt;Trang theo vai trò: Đặt lịch, Lịch hẹn của tôi, Chờ xác nhận, Hàng đợi, Gọi bệnh nhân, Quản trị&lt;br&gt;react-router-dom · react-oidc-context (OIDC + PKCE) · hook useApi gắn token Bearer&lt;br&gt;&lt;span style="font-size:13px;color:#555555"&gt;Màn hình số thứ tự /display công khai, không cần đăng nhập&lt;/span&gt;' style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fontColor=#000000;fontFamily=Arial;fontSize=14;fillColor=#E6E6E6;strokeColor=#898989;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="720" height="110" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b style="font-size:17px"&gt;Keycloak 26&lt;/b&gt;&lt;br&gt;Dịch vụ định danh OpenID Connect&lt;br&gt;realm hlt01, client hlt-web' style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fontColor=#000000;fontFamily=Arial;fontSize=14;fillColor=#DBDBDB;strokeColor=#838383;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="900" y="60" width="270" height="110" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b style="font-size:17px"&gt;Lớp API – Hlt.Api (ASP.NET Core Web API)&lt;/b&gt;&lt;br&gt;Controllers · xác thực JWT Bearer · ánh xạ vai trò (IClaimsTransformation)&lt;br&gt;Phân quyền [Authorize(Roles)] · đổi lỗi nghiệp vụ thành mã HTTP 400/403/404/409' style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fontColor=#000000;fontFamily=Arial;fontSize=14;fillColor=#F2F2F2;strokeColor=#B5B5B5;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="720" height="90" as="geometry"/></mxCell><mxCell id="c6" value='&lt;b style="font-size:17px"&gt;Lớp ứng dụng – Hlt.Application&lt;/b&gt;&lt;br&gt;BookingService · StaffService · QueueService · AdminService · CatalogService&lt;br&gt;Giao diện Repository, IUnitOfWork · Observer (AppointmentEvents, NotificationObserver) · DTO' style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fontColor=#000000;fontFamily=Arial;fontSize=14;fillColor=#E0E0E0;strokeColor=#9C9C9C;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="370" width="720" height="100" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b style="font-size:17px"&gt;Lớp miền – Hlt.Domain (không phụ thuộc hạ tầng)&lt;/b&gt;&lt;br&gt;AppUser, Patient, Doctor, Staff · DoctorSchedule, TimeSlot · Appointment, QueueTicket, Notification&lt;br&gt;Mẫu State (AppointmentState) · Mẫu Strategy (IQueueStrategy) · QueueManager' style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fontColor=#000000;fontFamily=Arial;fontSize=14;fillColor=#DADADA;strokeColor=#717171;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="720" height="100" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b style="font-size:17px"&gt;Lớp hạ tầng&lt;br&gt;Hlt.Infrastructure&lt;/b&gt;&lt;br&gt;&lt;br&gt;AppDbContext (EF Core 10)&lt;br&gt;Repository, UnitOfWork&lt;br&gt;NotificationDispatcher&lt;br&gt;LogEmailSender, LogSmsSender,&lt;br&gt;InAppSender&lt;br&gt;SlotHoldStore, DbSeeder' style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fontColor=#000000;fontFamily=Arial;fontSize=14;fillColor=#F5F5F5;strokeColor=#666666;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="900" y="370" width="270" height="250" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b style="font-size:16px"&gt;SQL Server 2022&lt;/b&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;fontColor=#000000;boundedLbl=1;backgroundOutline=1;size=18;fontFamily=Arial;fillColor=#E6E6E6;strokeColor=#898989;" vertex="1" parent="1"><mxGeometry x="915" y="662" width="240" height="86" as="geometry"/></mxCell><mxCell id="c10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1.6;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;endArrow=block;endFill=1;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1.6;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;endArrow=block;endFill=1;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1.6;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;endArrow=block;endFill=1;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1.6;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;endArrow=block;endFill=1;startArrow=block;startFill=1;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c1